# Nginx Production Dockerfile - 合同预审看板系统
# Contract Pre-Review System - Nginx Production Docker Image
# 
# 此 Dockerfile 用于生产环境,包含构建好的前端静态资源

FROM nginx:1.25-alpine

# 维护者信息
LABEL maintainer="Contract Pre-Review System"
LABEL description="Nginx reverse proxy with frontend static files for Contract Pre-Review System"

# 删除默认配置
RUN rm /etc/nginx/nginx.conf
RUN rm /etc/nginx/conf.d/default.conf

# 复制生产环境 Nginx 配置文件
COPY nginx.prod.conf /etc/nginx/nginx.conf

# 复制前端构建产物到 Nginx 静态资源目录
# 注意: 需要先在 frontend 目录执行 npm run build
COPY ../frontend/dist /usr/share/nginx/html

# 创建日志目录
RUN mkdir -p /var/log/nginx

# 设置正确的文件权限
RUN chown -R nginx:nginx /usr/share/nginx/html
RUN chmod -R 755 /usr/share/nginx/html

# 暴露端口
EXPOSE 80

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

# 启动 Nginx
CMD ["nginx", "-g", "daemon off;"]
