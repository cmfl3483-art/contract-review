# 生产环境变量模板
# 使用方式：
#   1. cp .env.prod.example .env.prod
#   2. 填入真实值（.env.prod 不会进 git）
#   3. docker compose -f docker-compose.prod.yml --env-file .env.prod -p prod up -d --build

# ===== JWT =====
# 用 openssl rand -base64 32 生成强密钥
# ⚠️ 生产环境必须用独立的密钥，不要复用 test 的
SECRET_KEY=__GENERATE_A_STRONG_RANDOM_KEY__

