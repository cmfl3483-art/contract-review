# 生产环境配置示例
# 复制此文件为 .env.production 并填写实际值

# 钉钉配置
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret
DINGTALK_CORP_ID=your-dingtalk-corp-id

# AI 配置
# 选项 1: 使用 DeepSeek API
AI_PROVIDER=deepseek
AI_API_BASE=https://api.deepseek.com/v1
AI_API_KEY=your-deepseek-api-key
AI_MODEL=deepseek-chat

# 选项 2: 使用自部署模型 (如 vLLM, Ollama)
# AI_PROVIDER=custom
# AI_API_BASE=http://your-model-server:8000/v1
# AI_API_KEY=your-api-key-or-empty
# AI_MODEL=qwen2.5-7b-instruct

# JWT 密钥 (请使用强随机字符串)
SECRET_KEY=your-very-secure-secret-key-change-this-in-production

# 数据库配置 (如果使用外部数据库)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Redis 配置 (如果使用外部 Redis)
# REDIS_URL=redis://host:6379/0

# MinIO 配置 (如果使用外部 MinIO 或 S3)
# MINIO_ENDPOINT=your-minio-endpoint:9000
# MINIO_ACCESS_KEY=your-access-key
# MINIO_SECRET_KEY=your-secret-key
# MINIO_BUCKET=contract-attachments
# MINIO_SECURE=true

# 应用配置
ENVIRONMENT=production
LOG_LEVEL=INFO
