# ============================================
# 合同预审看板系统 - 环境配置示例
# Contract Pre-Review System - Environment Configuration
# ============================================
# 
# 使用说明:
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据实际环境修改配置值
# 3. 生产环境请务必修改所有密钥和密码
#
# ============================================

# ============================================
# 基础配置 / Basic Configuration
# ============================================
PROJECT_NAME="合同预审看板系统"
ENVIRONMENT=development
DEBUG=true

# ============================================
# 数据库配置 / Database Configuration
# ============================================
# PostgreSQL 连接字符串格式:
# postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contract_review
DATABASE_ECHO=false

# ============================================
# Redis 配置 / Redis Configuration
# ============================================
# Redis 连接字符串格式: redis://主机:端口/数据库编号
REDIS_URL=redis://localhost:6379/0
# 缓存过期时间 (秒)
REDIS_CACHE_TTL=300

# ============================================
# MinIO 配置 / MinIO Configuration
# ============================================
# MinIO 服务地址 (不包含 http://)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 是否使用 HTTPS
MINIO_SECURE=false
# 存储桶名称
MINIO_BUCKET=contract-attachments

# ============================================
# JWT 配置 / JWT Configuration
# ============================================
# JWT 密钥 (生产环境请使用强随机字符串)
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-please-use-a-strong-random-string
ALGORITHM=HS256
# Token 过期时间 (分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# 钉钉配置 / DingTalk Configuration
# ============================================
# 钉钉应用凭证 (从钉钉开放平台获取)
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret
# 钉钉授权回调地址
DINGTALK_REDIRECT_URI=http://localhost:3000/auth/callback

# ============================================
# AI 配置 / AI Configuration
# ============================================
# AI 服务提供商: deepseek 或 custom
AI_PROVIDER=deepseek
# DeepSeek API 配置
AI_API_BASE=https://api.deepseek.com/v1
AI_API_KEY=your-deepseek-api-key
AI_MODEL=deepseek-chat
# 自部署模型配置示例 (使用 OpenAI 兼容 API):
# AI_PROVIDER=custom
# AI_API_BASE=http://localhost:8000/v1
# AI_API_KEY=your-api-key-or-empty
# AI_MODEL=qwen2.5-7b-instruct
# AI 请求超时时间 (秒)
AI_TIMEOUT=30

# ============================================
# Celery 配置 / Celery Configuration
# ============================================
# Celery 消息代理 (使用 Redis)
CELERY_BROKER_URL=redis://localhost:6379/1
# Celery 结果后端
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================
# CORS 配置 / CORS Configuration
# ============================================
# 允许的跨域源 (多个源用逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ============================================
# 文件上传配置 / File Upload Configuration
# ============================================
# 最大文件大小 (字节, 默认 20MB)
MAX_FILE_SIZE=20971520

# ============================================
# 日志配置 / Logging Configuration
# ============================================
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# 日志文件路径
LOG_FILE=logs/app.log
